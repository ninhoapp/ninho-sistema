# Exemplo de variáveis de ambiente do Ninho (site + painel)
# Copie para .env.local (que NÃO vai pro Git) e preencha com os valores reais.

# --- Domínio ---------------------------------------------------------------
# Canônico é COM www — o apex useninho.com.br responde 308 para www.
# Todo o site monta links a partir dessa variável (metadata, OpenGraph).
NEXT_PUBLIC_SITE_URL=https://www.useninho.com.br
NEXT_PUBLIC_LANDING_URL=
NEXT_PUBLIC_CONTATO_EMAIL=contato@useninho.com.br

# --- Lojas -----------------------------------------------------------------
# Pré-lançamento: deixe vazio. Nesse estado /get/ios e /get/android mandam
# para /landing/em-breve e o domínio raiz cai na /landing.
STORE_IOS_URL=
STORE_ANDROID_URL=

# --- Supabase --------------------------------------------------------------
# Banco lido pelo painel /admin.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Painel /admin ---------------------------------------------------------
# Segredo para assinar o cookie de sessão do painel (string aleatória longa).
SESSION_SECRET=

# --- Meta Pixel ------------------------------------------------------------
# ID do Pixel (Meta Business Suite > Pixels). Vazio em dev = pixel desligado.
NEXT_PUBLIC_META_PIXEL_ID=
